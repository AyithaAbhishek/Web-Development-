// MOBILE MENU

const hamburger = document.querySelector(".hamburger");
const navLinks = document.querySelector(".nav-links");

hamburger.addEventListener("click",()=>{
navLinks.classList.toggle("show");
});


// IMAGE SLIDER

let slides = document.querySelectorAll(".slide");
let index = 0;

function showSlide(){

slides.forEach(s=>s.classList.remove("active"));

index++;

if(index>=slides.length){
index=0;
}

slides[index].classList.add("active");

}

setInterval(showSlide,3000);


// FAQ ACCORDION

const questions = document.querySelectorAll(".faq-question");

questions.forEach(q=>{
q.addEventListener("click",()=>{

const answer = q.nextElementSibling;

answer.style.display =
answer.style.display === "block" ? "none" : "block";

});
});


// FORM VALIDATION

document.getElementById("contactForm")
.addEventListener("submit",function(e){

alert("Message sent successfully!");

});


*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Poppins;
}

body{
line-height:1.6;
}

/* NAVBAR */

.header{
position:sticky;
top:0;
background:white;
z-index:1000;
}

.navbar{
display:flex;
justify-content:space-between;
align-items:center;
padding:20px 10%;
}

.nav-links{
display:flex;
gap:20px;
list-style:none;
}

.nav-links a{
text-decoration:none;
color:black;
}

.hamburger{
display:none;
}

/* HERO */

.hero{
display:flex;
align-items:center;
justify-content:space-between;
padding:80px 10%;
background:linear-gradient(120deg,#5f9cff,#9ad0ff);
color:white;
}

.hero img{
width:300px;
}

.btn{
background:black;
color:white;
padding:10px 20px;
text-decoration:none;
margin-right:10px;
}

/* FEATURES */

.features{
padding:80px 10%;
text-align:center;
}

.feature-grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
gap:20px;
margin-top:30px;
}

.card{
padding:20px;
border-radius:10px;
background:#f4f4f4;
transition:0.3s;
}

.card:hover{
transform:translateY(-5px);
}

/* PRICING */

.pricing{
padding:80px 10%;
text-align:center;
}

.pricing-grid{
display:flex;
gap:20px;
justify-content:center;
flex-wrap:wrap;
}

.price-card{
padding:30px;
border:1px solid #ddd;
border-radius:10px;
width:250px;
}

.popular{
border:2px solid blue;
}

/* REVIEWS */

.review-grid{
display:flex;
gap:20px;
justify-content:center;
flex-wrap:wrap;
padding:50px;
}

.review{
text-align:center;
width:250px;
}

.review img{
width:80px;
border-radius:50%;
}

/* FAQ */

.faq{
padding:80px 10%;
}

.faq-question{
width:100%;
padding:15px;
text-align:left;
background:#eee;
border:none;
cursor:pointer;
}

.faq-answer{
display:none;
padding:15px;
background:#f9f9f9;
}

/* CONTACT */

.contact{
padding:80px 10%;
text-align:center;
}

form{
display:flex;
flex-direction:column;
max-width:400px;
margin:auto;
gap:10px;
}

input, textarea{
padding:10px;
}

/* FOOTER */

footer{
text-align:center;
padding:30px;
background:#222;
color:white;
}

.social i{
margin:10px;
}

/* MOBILE */

@media(max-width:768px){

.hero{
flex-direction:column;
text-align:center;
}

.nav-links{
display:none;
}

.hamburger{
display:block;
}

}
